# Lexicon - environment configuration
#
#   cp .env.example .env      # then replace the passwords
#
# docker compose reads this file to configure its containers. The Python code
# (API, `lexicon` CLI, ingestion, migrations) reads it too when run from the
# repository root; point ENV_FILE at another file to use that instead. Real
# environment variables always win over values in the file.
# Passwords may contain URL-special characters (the code URL-encodes them),
# but not '$' (docker compose interpolation) or a space.

# =============================================================================
# Databases
# =============================================================================

# Neo4j (required): holds the lexical graph. The neo4j image wants a password
# of 8+ characters without '/' (it parses NEO4J_AUTH as user/password)
NEO4J_PASSWORD=your_secure_password_here
# Default bolt://localhost:7687 (compose gives the api container bolt://neo4j:7687)
# NEO4J_URI=bolt://localhost:7687
# Default neo4j, the only user the compose neo4j container accepts (compose
# ignores this setting); set it only to use another Neo4j server
# NEO4J_USER=neo4j

# Elasticsearch (optional): fuzzy search; without it search uses Neo4j.
# ELASTICSEARCH_URI defaults to http://elastic:<password>@localhost:9200
ELASTICSEARCH_PASSWORD=your_secure_password_here
# ELASTICSEARCH_URI=

# Redis (optional): cache, and the rate-limit/export-job state that several
# API workers share. REDIS_URI defaults to redis://:<password>@localhost:6379
REDIS_PASSWORD=your_secure_password_here
# REDIS_URI=

# PostgreSQL (optional, reserved for future use: no code reads or writes it
# yet). Its container starts only with `docker compose --profile postgres up`.
# Migrations (make db-migrate) and scripts/load_initial_data.py connect with
# these values (host localhost:5432, or POSTGRES_HOST/POSTGRES_PORT). The API
# connects, and /health reports it, only when POSTGRES_URI is set.
POSTGRES_DB=linguistic_stratigraphy
POSTGRES_USER=ls_user
POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_URI=postgresql://ls_user:<password>@localhost:5432/linguistic_stratigraphy

# =============================================================================
# API
# =============================================================================

# API key for /api/v1 and /graphql, sent as the X-API-Key header. Empty turns
# authentication off (acceptable only on localhost); production requires it.
API_KEY=

# Browser origins allowed by CORS (comma-separated; never '*' in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# POST /api/v1/graph/query runs any read-only Cypher an API client sends.
# A single query can still use a lot of memory; set false where API keys go
# to clients you do not trust
# GRAPH_QUERY_ENABLED=true

# Per-client rate limit: RATE_LIMIT_REQUESTS per RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# A client is its connection's address or, when the connection comes from one
# of FORWARDED_ALLOW_IPS (comma-separated addresses or networks), the address
# in X-Forwarded-For. compose passes this to the api container; behind a
# reverse proxy set it as docker-compose.production.yml explains, or all
# clients share one budget
FORWARDED_ALLOW_IPS=127.0.0.1

# Address, port and worker processes of the host-side `ls-api` server
# (the api container always listens on 0.0.0.0:8000 inside its network).
# More than one worker shares rate-limit counters and export jobs via Redis.
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# =============================================================================
# Logging
# =============================================================================

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# "text" for development, "json" for log collectors
LOG_FORMAT=text
# Optional log file (empty: stdout only)
LOG_FILE=
# Per-component levels
API_LOG_LEVEL=INFO
PIPELINE_LOG_LEVEL=INFO
DB_LOG_LEVEL=WARNING
# Requests slower than this are logged as warnings
SLOW_REQUEST_THRESHOLD_MS=1000

# =============================================================================
# Environment and error tracking
# =============================================================================

# development, staging or production (production validates the settings
# above at startup and refuses to start without API_KEY and NEO4J_PASSWORD)
ENVIRONMENT=development
DEBUG=false
# Overrides the version the API reports (default: the code's own version)
# APP_VERSION=

# Sentry DSN (empty disables Sentry)
SENTRY_DSN=

# Optional: also ship WARNING+ logs to an Elasticsearch cluster
# (comma-separated hosts, or an Elastic Cloud ID, plus an API key)
ELASTICSEARCH_HOSTS=
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_API_KEY=
