# Lexicon - staging settings: production behaviour with a smaller footprint
#
#   cp config/.env.staging /secure/place/lexicon-staging.env   # fill it in there
#   docker compose --env-file /secure/place/lexicon-staging.env \
#       -f docker-compose.yml -f docker-compose.production.yml up -d
# or, for a host-side server:   ENV_FILE=/secure/place/lexicon-staging.env ls-api
# Replace the placeholder passwords and set API_KEY (the production overlay
# refuses to start without it; it also sets ENVIRONMENT=production).

ENVIRONMENT=staging
DEBUG=false
# APP_VERSION= (empty: the version of the code in the image)

# Databases (host-side defaults; compose points the api container at its
# own services)
NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j (the compose neo4j container accepts only neo4j;
# set it only to use another Neo4j server)
NEO4J_PASSWORD=your_secure_password_here
ELASTICSEARCH_PASSWORD=your_secure_password_here
REDIS_PASSWORD=your_secure_password_here

# API: key required by clients, explicit origins, rate limited
API_KEY=
CORS_ORIGINS=https://staging.example.org
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60
# Host-side `ls-api` only (the api container runs one worker on port 8000)
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=2

LOG_LEVEL=INFO
LOG_FORMAT=json
SLOW_REQUEST_THRESHOLD_MS=1000

SENTRY_DSN=
