# Lexicon - development settings
#
# For running the API or CLI on the host against the docker compose
# databases:   ENV_FILE=config/.env.development ls-api --reload
# The passwords must match the ones docker compose used (from ./.env).

ENVIRONMENT=development
DEBUG=true

# Databases (compose publishes them on localhost)
NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j (the compose neo4j container accepts only neo4j;
# set it only to use another Neo4j server)
NEO4J_PASSWORD=your_secure_password_here
ELASTICSEARCH_PASSWORD=your_secure_password_here
REDIS_PASSWORD=your_secure_password_here
# PostgreSQL is optional (compose profile "postgres"); set POSTGRES_URI only
# if the API should connect to it
POSTGRES_USER=ls_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=linguistic_stratigraphy

# API: no key, any origin, no rate limit, one auto-reloading worker
API_KEY=
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# Verbose text logs; flag requests slower than 500 ms
LOG_LEVEL=DEBUG
LOG_FORMAT=text
API_LOG_LEVEL=DEBUG
PIPELINE_LOG_LEVEL=DEBUG
DB_LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=500

SENTRY_DSN=
