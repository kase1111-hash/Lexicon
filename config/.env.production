# Lexicon - production settings template
#
#   cp config/.env.production /secure/place/lexicon.env   # fill it in there
#   docker compose --env-file /secure/place/lexicon.env \
#       -f docker-compose.yml -f docker-compose.production.yml up -d
# or, for a host-side server:   ENV_FILE=/secure/place/lexicon.env ls-api
#
# With ENVIRONMENT=production the API refuses to start unless NEO4J_PASSWORD
# and API_KEY are set, DEBUG is false, CORS_ORIGINS is not '*' and rate
# limiting is on. Serve it behind a TLS-terminating reverse proxy.

ENVIRONMENT=production
DEBUG=false
# APP_VERSION= (empty: the version of the code in the image)
# Image tag the production overlay runs (ghcr.io/kase1111-hash/lexicon:<VERSION>)
VERSION=latest

# Databases (host-side defaults; compose points the api container at its
# own services)
NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j (the compose neo4j container accepts only neo4j;
# set it only to use another Neo4j server)
NEO4J_PASSWORD=
ELASTICSEARCH_PASSWORD=
REDIS_PASSWORD=

# API
API_KEY=
CORS_ORIGINS=https://lexicon.example.org
# Arbitrary read-only Cypher (POST /api/v1/graph/query); false unless every
# API key holder is trusted
GRAPH_QUERY_ENABLED=false
# The reverse proxy's address as the api container sees it (see
# docker-compose.production.yml), so each client gets its own rate limit
FORWARDED_ALLOW_IPS=127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Host-side `ls-api` only (the api container runs one worker on port 8000).
# More than one worker needs Redis (shared rate limits and export jobs)
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=4

LOG_LEVEL=INFO
LOG_FORMAT=json
API_LOG_LEVEL=INFO
PIPELINE_LOG_LEVEL=INFO
DB_LOG_LEVEL=WARNING
SLOW_REQUEST_THRESHOLD_MS=2000

SENTRY_DSN=
